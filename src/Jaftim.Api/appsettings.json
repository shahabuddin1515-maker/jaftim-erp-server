{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "_comment": "Set these in user-secrets / environment variables / Key Vault. Never commit real values.",
    "Jaftim": "",
    "Hangfire": ""
  },

  "Database": {
    "CommandTimeoutSeconds": 60
  },

  "Auth": {
    "Issuer": "jaftim-api",
    "Audience": "jaftim-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },

  "OpenApi": {
    "_comment": "Enabled=null means Development only. Title/Version show in Swagger UI (/swagger) and Scalar (/scalar).",
    "Enabled": null,
    "Title": "Jaftim API",
    "Version": "v1"
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "IpAllowlist": {
    "Enabled": false,
    "Cidrs": [
      "125.209.124.208/28",
      "203.130.7.64/29",
      "103.104.193.104/29",
      "115.42.66.232/29",
      "110.93.230.26/32",
      "117.20.17.176/29",
      "124.29.197.145/32"
    ]
  },

  "SystemUser": {
    "UserProfileId": 1,
    "CompanyId": 1
  },

  "BlobStorage": {
    "ConnectionString": "",
    "ContainerName": "uicfiles"
  },

  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "Jaftim"
  }
}
